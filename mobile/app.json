{
  "expo": {
    "name": "AIDEP",
    "slug": "aidep-mobile",
    "version": "1.0.0",
    "scheme": "aidep",
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-image-picker"
    ],
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    }
  }
}
