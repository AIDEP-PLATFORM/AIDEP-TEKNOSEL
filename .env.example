ENVIRONMENT=development
# Docker Compose ile: backend konteyneri compose içindeki DATABASE_URL ile postgres:5432’ye bağlanır.
# Host’tan psql/DBeaver: localhost:5433 (compose postgres port eşlemesi)
# Doğrudan yerel geliştirme (uvicorn, docker dışı): aşağıdaki gibi localhost kullanın
DATABASE_URL=postgresql://aidep:aidep_pass@localhost:5433/aidep
REDIS_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SECRET_KEY=
AFAD_API_KEY=
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
